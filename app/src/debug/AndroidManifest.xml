<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="eu.kanade.translation.diagnostics.TranslationTraceDebugProvider"
            android:authorities="${applicationId}.translation-trace-debug-init"
            android:exported="false"
            android:initOrder="100" />

        <receiver
            android:name="eu.kanade.translation.diagnostics.TranslationMeasurementSessionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="eu.kanade.translation.action.MEASUREMENT_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
